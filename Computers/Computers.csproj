<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- The GAME_PATH environment variable overrides the local install path. -->
        <GamePath>$(GAME_PATH)</GamePath>
        <GamePath Condition="'$(GamePath)' == ''">/Users/nk2/Desktop/SVDev.app/Contents/MacOS</GamePath>
        <BundleExtraAssemblies>ThirdParty</BundleExtraAssemblies>
        <EnableGameDebugging>true</EnableGameDebugging>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Jint" Version="4.16.1" />
      <PackageReference Include="Lib.Harmony" Version="2.2.2" ExcludeAssets="runtime" />
      <PackageReference Include="Newtonsoft.Json" Version="13.0.5-beta1" />
      <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
      <PackageReference Include="YamlDotNet" Version="18.1.0" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="assets\" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="Computers.Tests" />
      <InternalsVisibleTo Include="Computers.E2e" />
    </ItemGroup>

</Project>
